use language/def
use entry

// A definition only its own file sees: its lines, and its other definitions (also when another file calls them).
// Example: internal def A0 as meters, in bmi.def
//          → `as meters` is unknown outside bmi.def (not checked)
modifier internal
    hook define end in python
        DEFINITION = self["cycle"]["definition"]
        if DEFINITION is None:
            raise DefException("internal marks a definition, not a name")
        DEFINITION.visibility = "file"
        DEFINITION.seen_by = lambda file: file == DEFINITION.file
