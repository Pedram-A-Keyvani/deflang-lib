use language/def
use entry

// One variable for the whole program: this file, its lines and its definitions use it; another file gets it with `use NAME from FILE`. The rest of the line runs as usual.
// Example: shared visits is 0
//          → visits is 0
modifier shared
    hook define start in python
        ENTRY = self["entry"]
        NAME = ENTRY.get("name") if ENTRY is not None else None
        if NAME is None or self["cycle"].get("variable") is None or self["cycle"]["definition"] is not None:
            raise DefException("shared names a variable, not a definition")
        HERE = self["file"]
        self["files"][HERE]["names"][NAME] = (HERE, NAME)
