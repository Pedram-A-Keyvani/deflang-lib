use flag/written
use checks

// ---- the console: talking with the person who runs the program
// (`give` with a condition checks every value with checks' `each of them is`)

// Asks the user for a value and stores it. With a number first, asks for that many and makes a list; a condition after the name checks each one.
// Example: give 2 numbers less than or equal to 14
//          → asks "numbers 1?" and "numbers 2?"; typing 5 and 9 makes numbers [5, 9]
python[written] give A0
    WORDS = A0.split(None, 2)
    if len(WORDS) >= 2 and parse_number(WORDS[0]) is not None:
        COUNT, NAME = parse_number(WORDS[0]), WORDS[1]
        ITEMS = []
        for i in range(COUNT):
            INPUT = input(f"   {NAME} {i + 1}? ").strip()
            ITEMS.append(INPUT if parse_number(INPUT) is None else parse_number(INPUT))
        self["variables"][NAME] = ITEMS
        self["variables"]["them"] = ITEMS
        if len(WORDS) == 3:
            self.run(NAME + " each of them is " + WORDS[2])
        return None
    INPUT = input(f"   {A0}? ").strip()
    self["variables"][A0] = INPUT if parse_number(INPUT) is None else parse_number(INPUT)

// Prints a value.
// Example: say "Hello " "Sam"
//          → prints Hello Sam
python say A0
    self.say(A0)

// Waits until the user presses Enter A0 times.
// Example: wait 2 times
//          → waits until Enter is pressed twice (not checked)
python[written] wait A0 times
python[written] wait A0
    for _ in range(number(self.run(A0))):
        input()
