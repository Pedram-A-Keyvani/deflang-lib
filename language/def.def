// def-lang: a def whose body is def-lang. Its lines run one by one, like a file's lines, with A0, A1, ... put in: every value is a variable of the call, named A0, A1, ...; or the words as they are written for a def that keeps its arguments' words. Its value is the value of the last line that has one. The variables it sets are its own and end with it; a def that keeps its arguments' words, or an entry's `does`, runs where it acts. Binding values as variables keeps the body's text the same on every call, so it is parsed once; the words written at the call are kept for error messages.
// Example: twice 4, with def twice A0 whose body is A0 * 2
//          → 8 (not checked)
language def
    does in python
        ENTRY = self["entry"]
        VALUES = ENTRY["values"]

        # the words, for a def that keeps them (lines kept for later are values)
        WORDS = ENTRY["as written"] and not any(isinstance(value, Line) for value in VALUES)
        IN_PLACE = WORDS or ENTRY["in place"]
        PREFIX = ENTRY["argument"]
        OWN, TEXTS, WRITTEN = {}, [], {}
        for N, VALUE in enumerate(VALUES):
            NAME = PREFIX + str(N)
            if WORDS:
                TEXTS.append(VALUE)
            elif IN_PLACE:
                TEXTS.append(as_code(VALUE))
            else:
                OWN[NAME] = VALUE
                TEXTS.append(NAME)
                WRITTEN[NAME] = as_code(VALUE)
        ENTRY["written"] = WRITTEN if not IN_PLACE else {}
        LINES = ENTRY["fill"](ENTRY["template"], TEXTS)
        if IN_PLACE:
            ENTRY["body"] = self.run_lines(LINES, ENTRY["definition"])
        else:
            with self.own_variables(ENTRY["definition"].file), self.display_values(ENTRY["written"]):
                self["variables"].update(OWN)
                ENTRY["body"] = self.run_lines(LINES, ENTRY["definition"])
