// HTML: the body is the def's value, with A0, A1, ... filled in as escaped text. An element with def="name" and nothing inside gets that def's result as its content, like <nav def="site nav"></nav>, <script def="web script"></script> or <style def="hello style"></style>. An html, javascript or css def's result goes in as it is (it is your own code); any other value is escaped.
// Example: greeting "<b>Sam</b>", with html greeting A0 whose body is <p>Hello A0</p>
//          → "<p>Hello &lt;b&gt;Sam&lt;/b&gt;</p>" (not checked)
language html
    editor html
    does in python
        import html
        import re
        ENTRY = self["entry"]

        def text(value):
            return value if isinstance(value, Code) else html.escape(as_text(value))

        def include(m):
            content = text(self.run(html.unescape(m.group(3))))
            if m.group(2).lower() in ("script", "style"):
                content = content.replace("</", "<\\/")  # the code cannot end its <script> or <style> early
            return m.group(1) + content + m.group(4)

        FILLED = ENTRY["fill"](ENTRY["template"], [text(value) for value in ENTRY["values"]])
        return Code(re.sub(r"(<(\w+)\b[^>]*?(?<![\w-])def=\"([^\"]+)\"[^>]*>)\s*(</\2\s*>)", include, FILLED))

// The HTML text A0 with each {{ … }} filled in with the value of the def-lang inside it, escaped. The def-lang runs where this line runs.
// Example: "<p>{{ 1 + 1 }}</p>" with each {{ }} filled in
//          → "<p>2</p>"
python A0 with each {{ }} filled in
    import html
    import re
    return Code(re.sub(r"\{\{(.+?)\}\}", lambda m: html.escape(as_text(self.run(m.group(1).strip()))), as_text(A0)))
