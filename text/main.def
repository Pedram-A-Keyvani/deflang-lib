// ---- text and lists

// How many letters a text has, or how many items a list has.
// Example: length of "hello"
//          → 5
python length of A0
python count of A0
    return len(A0)

// Splits a text into a list of words.
// Example: words of "a b c"
//          → ["a", "b", "c"]
python words of A0
    return str(A0).split()

// The text in capital letters.
// Example: "hi" in upper case
//          → "HI"
python A0 in upper case
    return str(A0).upper()

// The text in small letters.
// Example: "HI" in lower case
//          → "hi"
python A0 in lower case
    return str(A0).lower()

// The first item of a list.
// Example: first of [3, 9, 2]
//          → 3
python first of A0
    return A0[0]

// The last item of a list.
// Example: last of [3, 9, 2]
//          → 2
python last of A0
    return A0[-1]

// The largest number in a list.
// Example: largest of [3, 9, 2]
//          → 9
python largest of A0
    return max(number(item) for item in A0)

// The smallest number in a list.
// Example: smallest of [3, 9, 2]
//          → 2
python smallest of A0
    return min(number(item) for item in A0)

// The items of a list as one text, with A1 between them.
// Example: ["milk", "eggs"] joined with ", "
//          → "milk, eggs"
python A0 joined with A1
    return str(A1).join(as_text(item) for item in A0)

// The text A0 as HTML shows it: <, >, & and quotes written so a browser shows them as text.
// Example: "<b>" as html
//          → "&lt;b&gt;"
python A0 as html
    import html
    return html.escape(as_text(A0))

// A0 as JSON: a table is an object, a list an array.
// Example: [1, "a"] as json
//          → '[1, "a"]'
python A0 as json
    import json
    return json.dumps(A0, default=as_text)

// True if the text A0 starts with A1.
// Example: "/admin/users" starts with "/admin/"
//          → True
python A0 starts with A1
    return as_text(A0).startswith(as_text(A1))

// The parts of the text A0 between each A1, without the spaces around them.
// Example: "visits, time" split by ","
//          → ["visits", "time"]
python A0 split by A1
    return [PART.strip() for PART in as_text(A0).split(as_text(A1))]

// The text A0 without A1 at its end, as often as it is there.
// Example: "/admin//" without "/" at the end
//          → "/admin"
python A0 without A1 at the end
    TEXT, END = as_text(A0), as_text(A1)
    while END and TEXT.endswith(END):
        TEXT = TEXT[:-len(END)]
    return TEXT
