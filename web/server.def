argument is A
comment is //

// A small web server, for any website. Its bodies are Python: they touch the network,
// files and the request, which def-lang can't. What a page shows is up to your defs.
//
//   server on port 8000
//   page "/" shows "<h1>Hello</h1>"
//   page "/about" shows about page               // a def, run on every visit
//   api "/api/sum" runs total is 1 + 2 and sends total
//   the assets are in "static"                   // css, images, as they are
//   serve site page at "/"                       // "/" and every address under it
//   start the server                             // runs until Ctrl+C
//
// Inside a page:  query "name"  is ?name=... from the address or a form,
// and  template "file.html"  fills in {{ def-lang }} parts of a file.

// Sets the port of the website. Only this computer can connect.
// Example: server on port 8000
//          → the website is at http://localhost:8000 (not checked)
def python server on port A0
    self.store("web")["port"] = number(A0)
    self.store("web")["host"] = "127.0.0.1"

// Like `server on port`, but other computers on the network can connect too.
// Example: server on port 8000 for everyone
//          → other computers on the network can open it too (not checked)
def python server on port A0 for everyone
    self.store("web")["port"] = number(A0)
    self.store("web")["host"] = "0.0.0.0"

// Shows A1 at the address A0. A1 runs again on every visit.
// Example: page "/hello" shows "<h1>Hi</h1>"
//          → GET /hello answers <h1>Hi</h1>
def python as written page A0 shows A1
    # with the file of this line: a visit runs A1 with that file's variables
    self.store("web").setdefault("pages", {})[as_text(self.run(A0))] = (A1, self.variables.file)

// The website's assets (css, images, any file) are the files in the folder A0, sent as they are: /style.css is A0/style.css. The folder is relative to the program.
// Example: the assets are in "files"
//          → GET /a.txt answers hi, when files/a.txt holds hi
def python as written the assets are in A0
def python as written assets are in A0
    FOLDER = self.file_path(as_text(self.run(A0)))
    if not FOLDER.is_dir():
        raise DefException("no folder " + as_text(A0))
    self.store("web").setdefault("folders", []).append(FOLDER)

// The value of `?A0=...` in the address, or of a form field; empty if missing. On a page it is HTML-escaped, so visitors can't inject tags; an api sends it as data.
// Example: query "name", for GET /hello?name=Sam
//          → "Sam"
def python query A0
    import html
    REQUEST = getattr(self, "_request", None) or {}
    VALUE = str(REQUEST.get("query", {}).get(as_text(A0), ""))
    return html.escape(VALUE) if REQUEST.get("page", True) else VALUE

// At the address A0, runs A1 and sends the values named in A2 (separated by commas) as JSON: variables A1 set, shared variables, or defs. Each request has its own variables, so one visitor's values never reach another. For a single page application.
// Example: api "/api/sum" runs total is sum of [1, 2] and sends total
//          → GET /api/sum answers {"total": 3}
def python as written api A0 runs A1 and sends A2
    self.store("web").setdefault("apis", {})[as_text(self.run(A0))] = (A1, [name.strip() for name in A2.split(",")], self.variables.file)

// At the address A0, sends the values named in A1 (separated by commas) as JSON: defs (run for this request) or shared variables.
// Example: api "/api/visits" sends visits
//          → GET /api/visits answers {"visits": 3}, when visits was 3
def python as written api A0 sends A1
    self.store("web").setdefault("apis", {})[as_text(self.run(A0))] = (None, [name.strip() for name in A1.split(",")], self.variables.file)

// Shows A0 at the address A1 and every address under it (A1 "/" is /, /bmi, /hello, ...) that no api, page or asset answers and that has no file extension. A0 runs again on every visit. For a single page application, so its links and refreshes work; with several, the longest address wins.
// Example: serve "<p>app</p>" at "/"
//          → GET /bmi answers <p>app</p>
def python as written serve A0 at A1
    self.store("web").setdefault("served", {})[as_text(self.run(A1)).rstrip("/") or "/"] = (A0, self.variables.file)

// The address of the page being visited, like /hello.
// Example: requested path, for GET /hello
//          → "/hello"
def python requested path
    REQUEST = getattr(self, "_request", None) or {}
    return REQUEST.get("path", "")

// Reads an HTML file and fills in each `{{ ... }}` with the value of the def-lang inside it, HTML-escaped.
// Example: template "pages/hi.html"
//          → "<p>2</p>", when pages/hi.html holds <p>{{ 1 + 1 }}</p>
def python template A0
    import html
    import re
    TEXT = self.file_path(as_text(A0)).read_text()
    return Code(re.sub(r"\{\{(.+?)\}\}", lambda m: html.escape(as_text(self.run(m.group(1).strip()))), TEXT))

// Starts the website. It runs until Ctrl+C. How it runs comes from settings.toml in the program's folder, if there is one, and the file is read again whenever it is saved, while the website runs:
//   port = 8000          the port (it wins over `server on port`)
//   everyone = false     true: other computers on the network can connect
//   watch = 0            seconds between looking for changed .def files, when a page is visited; a changed file's defs are read again. 0: off (at least 0.1 otherwise)
// The settings file itself is looked at every second. A new port or everyone opens the new server before the old one closes; variables and defs stay. A setting that can't be used is reported and the last settings stay. A file read again also gets its new `use` lines; only main.def itself needs a restart.
// Example: start the server
//          → serving on http://localhost:8000 until Ctrl+C (not checked)
def python start the server
    import html
    import http.server
    import json
    import mimetypes
    import threading
    import time
    import tomllib
    import urllib.parse

    WEB = self.store("web")
    WEB.setdefault("pages", {})
    WEB.setdefault("folders", [])
    ENGINE = self
    SETTINGS_FILE = WEB["settings_file"] if "settings_file" in WEB else ENGINE.file_path("settings.toml")
    KINDS = {"port": int, "everyone": bool, "watch": (int, float)}
    SETTINGS_EVERY = 1  # seconds between looks at the settings file

    def read_settings():
        """main.def's settings, with the settings file's over them."""
        settings = {"port": WEB.get("port", 8000), "everyone": WEB.get("host") == "0.0.0.0", "watch": 0}
        if SETTINGS_FILE is None or not SETTINGS_FILE.is_file():
            return settings
        try:
            found = tomllib.loads(SETTINGS_FILE.read_text())
        except tomllib.TOMLDecodeError as error:
            raise DefException(SETTINGS_FILE.name + ": " + str(error))
        for name, value in found.items():
            if name not in KINDS:
                raise DefException(SETTINGS_FILE.name + ": unknown setting '" + name + "' (the settings are " + ", ".join(KINDS) + ")")
            if isinstance(value, bool) != (KINDS[name] is bool) or not isinstance(value, KINDS[name]):
                kind = {int: "a whole number", bool: "true or false"}.get(KINDS[name], "a number")
                raise DefException(SETTINGS_FILE.name + ": " + name + " must be " + kind)
        if not 0 <= found.get("port", 0) <= 65535:
            raise DefException(SETTINGS_FILE.name + ": port must be between 0 and 65535")
        if found.get("watch", 0) < 0 or 0 < found.get("watch", 0) < 0.1:
            raise DefException(SETTINGS_FILE.name + ": watch is 0 (off), or at least 0.1 seconds")
        settings.update(found)
        return settings

    def stamp():
        try:
            return SETTINGS_FILE.stat().st_mtime_ns
        except (AttributeError, OSError):
            return None

    def address(settings):
        return ("0.0.0.0" if settings["everyone"] else "127.0.0.1", settings["port"])

    def where(server):
        host, port = server.server_address[:2]
        return "http://" + ("localhost" if host == "127.0.0.1" else host) + ":" + str(port)

    def watching(settings):
        return "  (watching .def files every " + as_text(settings["watch"]) + " s)" if settings["watch"] else ""

    def shown(path):
        for folder in (ENGINE.program_dir, PROJECT):
            if folder and path.is_relative_to(folder):
                return str(path.relative_to(folder))
        return path.name

    from pathlib import Path
    PROJECT = Path.cwd()
    STATE = {"settings": read_settings(), "stamp": stamp(), "checked": time.monotonic()}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            self.respond(b"")

        def do_POST(self):
            self.respond(self.rfile.read(int(self.headers.get("Content-Length") or 0)))

        def respond(self, body):
            url = urllib.parse.urlsplit(self.path)
            query = {k: v[-1] for k, v in urllib.parse.parse_qs(url.query).items()}
            query.update({k: v[-1] for k, v in urllib.parse.parse_qs(body.decode("utf-8", "replace")).items()})
            ENGINE._request = {"path": url.path, "query": query, "page": url.path not in WEB.get("apis", {})}
            try:
                self.answer(url)
            finally:
                ENGINE._request = None

        def run_for(self, code, file):
            """Run a page's or an api's words for this request: with variables of the request's
            own, on top of those of the file the page or api line is in. Only shared ones
            outlive the request."""
            with ENGINE.own_variables(file):
                return ENGINE.run(code)

        def answer(self, url):
            try:
                if url.path in WEB.get("apis", {}):
                    return self.api(*WEB["apis"][url.path])
                if url.path in WEB["pages"]:
                    self.fresh()
                    page = as_text(self.run_for(*WEB["pages"][url.path]))
                    return self.send(200, page.encode(), "text/html; charset=utf-8")
                for folder in WEB["folders"]:
                    file = (folder / urllib.parse.unquote(url.path).lstrip("/")).resolve()
                    if file.is_dir():
                        file = file / "index.html"
                    if file.is_relative_to(folder) and file.is_file():
                        kind = mimetypes.guess_type(file.name)[0] or "application/octet-stream"
                        return self.send(200, file.read_bytes(), kind)
                last = url.path.rstrip("/").rsplit("/", 1)[-1]
                if "." not in last:
                    path = url.path.rstrip("/") or "/"
                    under = [at for at in WEB.get("served", {}) if at == "/" or path == at or path.startswith(at + "/")]
                    if under:
                        self.fresh()
                        page = as_text(self.run_for(*WEB["served"][max(under, key=len)]))
                        return self.send(200, page.encode(), "text/html; charset=utf-8")
                self.send(404, b"<h1>404</h1><p>page not found</p>", "text/html; charset=utf-8")
            except DefException as error:
                message = "<h1>500</h1><pre>" + html.escape(" ".join(map(str, error.args))) + "</pre>"
                self.send(500, message.encode(), "text/html; charset=utf-8")

        def fresh(self):
            """With watch on: read the .def files saved since the last look again."""
            settings = STATE["settings"]
            if not settings["watch"] or time.monotonic() - STATE["checked"] < settings["watch"]:
                return
            STATE["checked"] = time.monotonic()
            for path in ENGINE.changed_files():
                try:
                    ENGINE.reload(path)
                    ENGINE.say("read again: " + shown(path))
                except DefException as error:
                    ENGINE.say("not read again: " + " ".join(map(str, error.args)) + "; the old defs stay")

        def api(self, run, names, file):
            try:
                with ENGINE.own_variables(file):
                    if run:
                        ENGINE.run(run)
                    data = {name: ENGINE.run(name) for name in names}
                self.send(200, json.dumps(data, default=as_text).encode(), "application/json")
            except DefException as error:
                message = {"error": " ".join(map(str, error.args))}
                self.send(400, json.dumps(message).encode(), "application/json")

        def send(self, status, data, kind):
            self.send_response(status)
            self.send_header("Content-Type", kind)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def log_message(self, format, *args):
            ENGINE.say(self.command + " " + self.path + " " + str(args[1] if len(args) > 1 else ""))

    def open_server(settings):
        try:
            return http.server.HTTPServer(address(settings), Handler)
        except OSError as error:
            raise DefException("cannot serve on port " + str(settings["port"]) + ": " + (error.strerror or str(error)))

    def move(server, settings):
        """The server for the new settings, opened before the old one closes; the old
        one (still open, or opened again) if it can't be."""
        try:
            return open_server(settings)
        except DefException as error:
            if settings["port"] != server.server_address[1]:
                ENGINE.say("settings not changed: " + " ".join(map(str, error.args)) + "; still on " + where(server))
                return server
        # the same port, for other computers or only this one: the old one closes first
        server.server_close()
        try:
            return open_server(settings)
        except DefException as error:
            ENGINE.say("settings not changed: " + " ".join(map(str, error.args)))
            return open_server(STATE["settings"])

    STOP = threading.Event()

    def watch():
        """Reads the settings file again when it is saved."""
        while not STOP.wait(SETTINGS_EVERY):
            now = stamp()
            if now == STATE["stamp"]:
                continue
            STATE["stamp"] = now
            try:
                settings = read_settings()
            except DefException as error:
                ENGINE.say("settings not changed: " + " ".join(map(str, error.args)) + "; the last settings stay")
                continue
            host, port = WEB["server"].server_address[:2]
            if address(settings)[0] != host or settings["port"] not in (port, STATE["settings"]["port"]):
                WEB["move_to"] = settings
                WEB["server"].shutdown()  # the loop below moves it
                continue
            changes = [name + " is " + json.dumps(settings[name]) for name in ("watch",) if settings[name] != STATE["settings"][name]]
            STATE["settings"] = settings
            if changes:
                ENGINE.say("settings changed: " + ", ".join(changes))

    SERVER = open_server(STATE["settings"])
    WEB["server"] = SERVER
    ENGINE.say("serving on " + where(SERVER) + watching(STATE["settings"]) + "  (Ctrl+C to stop)")
    if SETTINGS_FILE is not None:
        threading.Thread(target=watch, daemon=True).start()
    try:
        while True:
            SERVER.serve_forever()
            settings = WEB.pop("move_to", None)
            if settings is None:
                break  # stopped
            moved = move(SERVER, settings)
            if moved is SERVER:
                continue  # still the old one
            SERVER.server_close()
            SERVER = moved
            WEB["server"] = SERVER
            if address(settings) == (SERVER.server_address[0], settings["port"]):
                STATE["settings"] = settings
                ENGINE.say("settings changed: now on " + where(SERVER) + watching(settings))
    except KeyboardInterrupt:
        ENGINE.say("server stopped")
    finally:
        STOP.set()
        SERVER.server_close()
