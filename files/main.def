use flag/written
use time

// ---- files and folders: a relative name starts in the program's folder

// The folder A0; an error if there is none.
// Example: the folder "static"
//          → the folder static in the program's folder (not checked)
python the folder A0
    FOLDER = (self["program"] / as_text(A0)).resolve()
    if not FOLDER.is_dir():
        raise DefException("no folder " + as_text(A0))
    return FOLDER

// The file at the relative path A0 in one of the folders A1 (a folder, or a list of them). Nothing if there is none, and never a file outside them. Web addresses, like /style.css or a folder's index.html, are the website library's job.
// Example: the file "style.css" in folders
//          → the file FOLDER/style.css, if it is there (not checked)
python the file A0 in A1
    from pathlib import Path
    for FOLDER in (A1 if isinstance(A1, list) else [A1]):
        FOLDER = Path(FOLDER).resolve()
        FILE = (FOLDER / as_text(A0)).resolve()
        if FILE.is_relative_to(FOLDER) and FILE.is_file():
            return FILE
    return None

// True if A0 is a file.
// Example: "settings.toml" is a file
//          → True, when settings.toml holds port = 8000
python A0 is a file
    return (self["program"] / as_text(A0)).is_file()

// When the file A0 was last saved (a number that grows); nothing if there is no such file.
// Example: the time of file "settings.toml"
//          → a number, when the file is there (not checked)
python the time of file A0
    FILE = self["program"] / as_text(A0)
    return FILE.stat().st_mtime_ns if FILE.is_file() else None

// The text in the file A0.
// Example: the text of file "a.txt"
//          → "hi", when a.txt holds hi
python the text of file A0
    return (self["program"] / as_text(A0)).read_text()

// What the file A0 holds, as it is (bytes).
// Example: the bytes of file "a.txt"
//          → b"hi", when a.txt holds hi
python the bytes of file A0
    return (self["program"] / as_text(A0)).read_bytes()

// The kind of the file A0, as the web names it: text/css, image/png, ...
// Example: the kind of file "style.css"
//          → "text/css"
python the kind of file A0
    import mimetypes
    return mimetypes.guess_type(as_text(A0))[0] or "application/octet-stream"

// The table in the TOML file A0. An error says the file's name, and what is wrong.
// Example: the table in file "settings.toml"
//          → {"port": 8000}, when settings.toml holds port = 8000
python the table in file A0
    import tomllib
    FILE = self["program"] / as_text(A0)
    try:
        return tomllib.loads(FILE.read_text())
    except tomllib.TOMLDecodeError as ERROR:
        raise DefException(FILE.name + ": " + str(ERROR))

// Runs the line A1 whenever the file A0 is saved, while the program waits for something (it is looked at every second: time's `every … seconds`), with variables of its own, on top of those of the file of this line.
// Example: when the file "settings.toml" is saved : say "saved"
//          → says saved after each save, while a server waits (not checked)
python[written] when the file A0 is saved : A1
    import time
    FILE = self["program"] / as_text(self.run(A0))

    def STAMP():
        try:
            return FILE.stat().st_mtime_ns
        except OSError:
            return None
    ENGINE, HERE, LINE, LAST = self, self["file"], A1, [STAMP()]

    def RUN():
        if STAMP() != LAST[0]:
            LAST[0] = STAMP()
            with ENGINE.own_variables(HERE):
                ENGINE.run(LINE)
    EVERY = self["store"]["time"].setdefault("every", [])
    KEY = ("saved", str(FILE), LINE, HERE)
    EVERY[:] = [E for E in EVERY if E["key"] != KEY]
    EVERY.append({"key": KEY, "seconds": 1, "next": time.monotonic() + 1, "run": RUN})
