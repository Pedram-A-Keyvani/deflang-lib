use flag/written

// ---- values: naming them, choosing one, and other words for words

// Stores the value of A1 under the name A0.
// Example: x is 2 + 3
//          → x is 5
python[written] A0 is A1
    self["variables"][A0] = self.run(A1)

// A0 when A1 is true, otherwise A2. Only the part that is chosen runs.
// Example: 175 / 100 if 175 > 3 otherwise 175
//          → 1.75
python[written] A0 if A1 otherwise A2
    return self.run(A0) if self.run(A1) else self.run(A2)

// From now on, the words A0 are read as A1.
// Example: tiny means 0.001
//          → tiny * 2 is 0.002
python[written] A0 means A1
    self["aliases"][A0] = A1
