    self.say(A0)

// Adds A0 to the end of the list A1, making the list if needed.
// Example: add "eggs" to list
//          → list is ["milk", "eggs"], when it was ["milk"]
python[written] add A0 to A1
    self["variables"].setdefault(A1, []).append(self.run(A0))

// Removes A0 from the list A1; an error if it isn't there.
// Example: remove "milk" from list
//          → list is ["eggs"], when it was ["milk", "eggs"]
python[written] remove A0 from A1
    VALUE = self.run(A0)
    if VALUE not in self["variables"].get(A1, []):
        raise DefException(as_text(VALUE) + " is not in " + A1)
    self["variables"][A1].remove(VALUE)

